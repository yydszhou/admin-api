                  "pm.test('有 user:view 权限', () => pm.expect(json.data.permissions).to.include('user:view'));",
                  "pm.test('无 user:delete 权限', () => pm.expect(json.data.permissions).to.not.include('user:delete'));",
                  "pm.test('无 config:update 权限', () => pm.expect(json.data.permissions).to.not.include('config:update'));",
                  "pm.collectionVariables.set('auditorToken', json.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"auditor\",\n  \"password\": \"audit123\",\n  \"traceId\": \"trace-login-auditor\"\n}"
