    {
      "name": "03 - 获取当前用户信息 /api/me",
      "item": [

        {
          "name": "✅ admin Token - 获取成功（含全量权限）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('业务码 200', () => pm.expect(json.code).to.eql(200));",
                  "pm.test('username 为 admin', () => pm.expect(json.data.username).to.eql('admin'));",
                  "pm.test('roles 含 ADMIN', () => pm.expect(json.data.roles).to.include('ADMIN'));",
                  "pm.test('permissions 含 user:delete', () => pm.expect(json.data.permissions).to.include('user:delete'));",
                  "pm.test('permissions 含 config:update', () => pm.expect(json.data.permissions).to.include('config:update'));",
                  "pm.test('permissions 含 report:export', () => pm.expect(json.data.permissions).to.include('report:export'));",
                  "pm.test('不暴露密码', () => pm.expect(json.data.password).to.be.undefined);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "X-Trace-Id",    "value": "trace-me-admin" }
            ],
            "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api","me"] }
          }
        },

        {
          "name": "✅ operator Token - 获取成功（受限权限）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('业务码 200', () => pm.expect(json.code).to.eql(200));",
                  "pm.test('username 为 operator', () => pm.expect(json.data.username).to.eql('operator'));",
                  "pm.test('有 user:view', () => pm.expect(json.data.permissions).to.include('user:view'));",
                  "pm.test('有 report:export', () => pm.expect(json.data.permissions).to.include('report:export'));",
                  "pm.test('无 user:delete', () => pm.expect(json.data.permissions).to.not.include('user:delete'));",
                  "pm.test('无 config:update', () => pm.expect(json.data.permissions).to.not.include('config:update'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{operatorToken}}" },
              { "key": "X-Trace-Id",    "value": "trace-me-operator" }
            ],
            "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api","me"] }
          }
        },

        {
          "name": "✅ auditor Token - 获取成功（只读权限）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('业务码 200', () => pm.expect(json.code).to.eql(200));",
