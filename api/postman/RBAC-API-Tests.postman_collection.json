{
  "info": {
    "_postman_id": "rbac-api-test-collection-v1",
    "name": "RBAC API 完整测试集合",
    "description": "覆盖：注册、登录、获取用户信息、权限校验（user:delete / config:update / report:export）等全场景测试\n\n测试账号：\n- admin / admin123       → ADMIN（全部权限）\n- operator / oper123     → OPERATOR（user:view/create/update + report:view/export）\n- auditor / audit123     → AUDITOR（user:view + report:view + config:view）",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "variable": [
    { "key": "baseUrl",        "value": "http://localhost:8080",  "type": "string" },
    { "key": "adminToken",     "value": "",                       "type": "string" },
    { "key": "operatorToken",  "value": "",                       "type": "string" },
    { "key": "auditorToken",   "value": "",                       "type": "string" },
    { "key": "newUserId",      "value": "",                       "type": "string" }
  ],

  "item": [

    {
      "name": "01 - 用户注册",
      "item": [

        {
          "name": "✅ 正常注册",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('业务码 200', () => pm.expect(json.code).to.eql(200));",
                  "pm.test('返回 userId', () => pm.expect(json.data.id).to.be.a('number'));",
                  "pm.test('返回 username', () => pm.expect(json.data.username).to.eql('testuser_001'));",
                  "pm.test('不暴露密码', () => pm.expect(json.data.password).to.be.undefined);",
                  "pm.test('包含 traceId', () => pm.expect(json.traceId).to.eql('trace-register-001'));",
                  "// 保存新用户ID供后续删除测试使用",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('newUserId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser_001\",\n  \"email\": \"testuser001@example.com\",\n  \"password\": \"Test@123456\",\n  \"traceId\": \"trace-register-001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/register", "host": ["{{baseUrl}}"], "path": ["api","users","register"] }
          }
        },

