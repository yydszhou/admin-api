    {
      "name": "02 - 用户登录",
      "item": [

        {
          "name": "✅ admin 登录成功（ADMIN角色）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('业务码 200', () => pm.expect(json.code).to.eql(200));",
                  "pm.test('消息：登录成功', () => pm.expect(json.message).to.eql('登录成功'));",
                  "pm.test('返回 token', () => pm.expect(json.data.token).to.be.a('string').and.have.lengthOf(64));",
                  "pm.test('返回 userId', () => pm.expect(json.data.userId).to.be.a('number'));",
                  "pm.test('返回 roles 含 ADMIN', () => pm.expect(json.data.roles).to.include('ADMIN'));",
                  "pm.test('返回 permissions 含 user:delete', () => pm.expect(json.data.permissions).to.include('user:delete'));",
                  "pm.test('不暴露密码', () => pm.expect(json.data.password).to.be.undefined);",
                  "pm.test('包含 traceId', () => pm.expect(json.traceId).to.eql('trace-login-admin'));",
                  "// 保存 token 供后续测试使用",
                  "pm.collectionVariables.set('adminToken', json.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\",\n  \"traceId\": \"trace-login-admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/login", "host": ["{{baseUrl}}"], "path": ["api","users","login"] }
          }
        },

        {
          "name": "✅ operator 登录成功（OPERATOR角色）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('业务码 200', () => pm.expect(json.code).to.eql(200));",
                  "pm.test('返回 token', () => pm.expect(json.data.token).to.be.a('string'));",
                  "pm.test('roles 含 OPERATOR', () => pm.expect(json.data.roles).to.include('OPERATOR'));",
                  "pm.test('有 report:export 权限', () => pm.expect(json.data.permissions).to.include('report:export'));",
                  "pm.test('无 user:delete 权限', () => pm.expect(json.data.permissions).to.not.include('user:delete'));",
                  "pm.collectionVariables.set('operatorToken', json.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"operator\",\n  \"password\": \"oper123\",\n  \"traceId\": \"trace-login-operator\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/login", "host": ["{{baseUrl}}"], "path": ["api","users","login"] }
          }
        },

        {
          "name": "✅ auditor 登录成功（AUDITOR角色）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
